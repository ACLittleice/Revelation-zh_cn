#extension GL_KHR_shader_subgroup_arithmetic : enable

//======// Input //===============================================================================//

layout (local_size_x = 256, local_size_y = 1) in;
const ivec3 workGroups = ivec3(1, 1, 1);

//======// Utility //=============================================================================//

#include "/lib/Utility.glsl"

//======// Uniform //=============================================================================//

#include "/lib/universal/Uniform.glsl"

//======// SSBO //================================================================================//

#include "/lib/universal/SSBO.glsl"

//======// Shared Memory //=======================================================================//

#ifdef SUBGROUP_OPS
	#if defined MC_GL_VENDOR_NVIDIA
		shared vec3[9] sharedSkySH[gl_NumSubgroups];
	#else
		shared vec3[9] sharedSkySH[8];
	#endif
#else
	shared vec3[9] sharedSkySH[gl_WorkGroupSize.x];
#endif

//======// Function //============================================================================//

#include "/lib/universal/Random.glsl"
#include "/lib/atmosphere/Common.glsl"

vec3 sampleUniformSphere(in vec2 xy) {
    float phi = TAU * xy.x;
    float cosTheta = xy.y * 2.0 - 1.0;
    float sinTheta = sqrt(saturate(1.0 - cosTheta * cosTheta));

	return vec3(cossin(phi) * sinTheta, cosTheta);
}

void ParallelReduceSum(in uint index, in uint samples) {
	for (uint stride = samples >> 1u; stride > 0u; stride >>= 1u) {
		if (index < stride) {
			for (uint band = 0u; band < 9u; ++band) {
				sharedSkySH[index][band] += sharedSkySH[index + stride][band];
			}
		}

    	memoryBarrierShared();
		barrier();
	}
}

//======// Main //================================================================================//
void main() {
	const uint samples = gl_WorkGroupSize.x;

    uint index = gl_LocalInvocationIndex;

	// Sample and compute SH coefficients
	vec3 direction = sampleUniformSphere(Hammersley(index, samples));
	vec3 skyRadiance = texture(skyViewTex, FromSkyViewLutParams(direction) + vec2(0.0, 0.5)).rgb;

	// Estimate contribution
	skyRadiance *= saturate(direction.y * 4.0 + 1.0) * 1.5 + 0.5;

	vec3[9] shCoeff;
	float[9] basis = BasisSH3(direction);
	for (uint band = 0u; band < 9u; ++band) {
		shCoeff[band] = basis[band] * (TAU / float(samples)) * skyRadiance;
	}

	#ifdef SUBGROUP_OPS
		// Reduce SH coefficients in subgroup
		for (uint band = 0u; band < 9u; ++band) {
			shCoeff[band] = subgroupAdd(shCoeff[band]);
			SCALARIZED_LOAD(sharedSkySH[gl_SubgroupID][band], shCoeff[band]);
		}
		barrier();

		if (index < gl_NumSubgroups) {
			for (uint band = 0u; band < 9u; ++band) {
				shCoeff[band] = subgroupAdd(sharedSkySH[index][band]);
			}
		}
		barrier();
	#else
		// Reduce SH coefficients in shared memory
		for (uint band = 0u; band < 9u; ++band) {
			sharedSkySH[index][band] = shCoeff[band];
		}
		barrier();

		ParallelReduceSum(index, samples);

		for (uint band = 0u; band < 9u; ++band) {
			shCoeff[band] = sharedSkySH[0][band];
		}
	#endif

	// Store SH coefficients in thread 0
	if (index == 0u) {
		global.light.skySH = shCoeff;

		// Evaluate sky illuminance from SH coefficients (facing up)
		global.light.skyIlluminance = ReconstructSH3(shCoeff, vec3(0.0, 1.0, 0.0));
	}
}
